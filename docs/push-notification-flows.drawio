<mxfile host="Electron" pages="3">
  <diagram name="1. Overview: every path to APNs and FCM" id="overview">
    <mxGraphModel dx="673" dy="340" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="overview-n-1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=18;" value="Push notifications: every path to APNs and FCM" vertex="1">
          <mxGeometry height="30" width="900" x="20" y="10" as="geometry" />
        </mxCell>
        <mxCell id="overview-n-2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" value="Signed-in devices go through &lt;b&gt;push_jobs&lt;/b&gt; and the push pipeline. Signed-out (anonymous) devices only get bulletins, through the older dispatcher at the bottom. macOS receives no server pushes." vertex="1">
          <mxGeometry height="20" width="1300" x="20" y="42" as="geometry" />
        </mxCell>
        <mxCell id="overview-n-3" parent="1" style="swimlane;startSize=26;fontStyle=1;fontSize=13;align=left;spacingLeft=10;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1a1a1a;" value="Who files a push job" vertex="1">
          <mxGeometry height="1080" width="330" x="20" y="80" as="geometry" />
        </mxCell>
        <mxCell id="overview-ios-4" parent="overview-n-3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" value="&lt;b&gt;iPhone / iPad app&lt;/b&gt;&lt;br&gt;&lt;b&gt;POST /v3/schedule/sync&lt;/b&gt;&lt;br&gt;upcoming class / assignment events → one &lt;i&gt;schedule&lt;/i&gt; start job each, at the event&#39;s time (inClass, classPreparing, assignmentUrgent). Jobs missing from the upload are cancelled.&lt;br&gt;&lt;b&gt;POST /v3/live-activities/register&lt;/b&gt;&lt;br&gt;an activity&#39;s update token → its &lt;i&gt;end&lt;/i&gt; job at countdown_target (priority 10)" vertex="1">
          <mxGeometry height="150" width="310" x="10" y="36" as="geometry" />
        </mxCell>
        <mxCell id="overview-upl-5" parent="overview-n-3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" value="&lt;b&gt;Any signed-in app (iOS or Android)&lt;/b&gt;&lt;br&gt;data uploads and overrides (courses, assignments, settings) → &lt;i&gt;sync_trigger&lt;/i&gt; for the account&#39;s other devices, at most one per 5 min, then an immediate tick" vertex="1">
          <mxGeometry height="92" width="310" x="10" y="196" as="geometry" />
        </mxCell>
        <mxCell id="overview-exe-6" parent="overview-n-3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;" value="&lt;b&gt;Server sync executor&lt;/b&gt; (every 30s)&lt;br&gt;Moodle / NTUST sync found changes → &lt;i&gt;sync_trigger&lt;/i&gt;&lt;br&gt;school rejected the stored credential → &lt;i&gt;reauth_required&lt;/i&gt;" vertex="1">
          <mxGeometry height="76" width="310" x="10" y="298" as="geometry" />
        </mxCell>
        <mxCell id="overview-ar-7" parent="overview-n-3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;" value="&lt;b&gt;Assignment reminder scan&lt;/b&gt;&lt;br&gt;per due assignment and offset → &lt;i&gt;assignment&lt;/i&gt; job (assignment_reminder)" vertex="1">
          <mxGeometry height="60" width="310" x="10" y="384" as="geometry" />
        </mxCell>
        <mxCell id="overview-cr-8" parent="overview-n-3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;" value="&lt;b&gt;Course reminder scan&lt;/b&gt;&lt;br&gt;per class occurrence and offset (skips holidays) → &lt;i&gt;course&lt;/i&gt; job (course_reminder). Filed only for accounts with an iPhone or iPad." vertex="1">
          <mxGeometry height="76" width="310" x="10" y="454" as="geometry" />
        </mxCell>
        <mxCell id="overview-bul-9" parent="overview-n-3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;" value="&lt;b&gt;Bulletin pipeline&lt;/b&gt;&lt;br&gt;scrape (10 min) → LLM process (60s) → user dispatch: matched signed-in users → &lt;i&gt;bulletin&lt;/i&gt; job (bulletin_id)" vertex="1">
          <mxGeometry height="76" width="310" x="10" y="540" as="geometry" />
        </mxCell>
        <mxCell id="overview-sub-10" parent="overview-n-3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;" value="&lt;b&gt;Assignment submitted&lt;/b&gt; (sync / upload)&lt;br&gt;cancels its pending reminders and moves the end job of its running assignmentUrgent Live Activity to &lt;i&gt;now&lt;/i&gt;" vertex="1">
          <mxGeometry height="76" width="310" x="10" y="626" as="geometry" />
        </mxCell>
        <mxCell id="overview-por-11" parent="overview-n-3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1a1a1a;" value="&lt;b&gt;Portal (operator)&lt;/b&gt;&lt;br&gt;Custom push → &lt;i&gt;custom&lt;/i&gt; job per device:&lt;br&gt;&amp;nbsp;• popup → custom_push_popup (notification_id)&lt;br&gt;&amp;nbsp;• keep record → custom_push_bulletin (bulletin_id)&lt;br&gt;Tests: start a Live Activity, end one now, send reauth_required&lt;br&gt;“Run now” → immediate tick" vertex="1">
          <mxGeometry height="120" width="310" x="10" y="712" as="geometry" />
        </mxCell>
        <mxCell id="overview-local-12" parent="overview-n-3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;" value="&lt;b&gt;Not from the server&lt;/b&gt;&lt;br&gt;Android schedules class and assignment reminders locally.&lt;br&gt;iOS before 2.1.0 schedules assignment reminders locally.&lt;br&gt;The iOS app also ends an expired Live Activity itself when it is running (1s after the countdown, and on foreground)." vertex="1">
          <mxGeometry height="100" width="310" x="10" y="842" as="geometry" />
        </mxCell>
        <mxCell id="overview-jobs-13" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" value="&lt;b&gt;push_jobs&lt;/b&gt;&lt;br&gt;channel: schedule · system · assignment · course · bulletin · custom&lt;br&gt;priority: Live Activity 10, others 100" vertex="1">
          <mxGeometry height="110" width="250" x="420" y="360" as="geometry" />
        </mxCell>
        <mxCell id="overview-pipe-14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" value="&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;b&gt;Push pipeline tick&lt;/b&gt;&lt;br&gt;every 5s, plus an immediate tick after uploads and portal sends&lt;br&gt;&lt;br&gt;1. recover jobs stuck in &lt;i&gt;processing&lt;/i&gt; &amp;gt; 5 min&lt;br&gt;2. claim due jobs, lowest priority first, a batch at a time, until none are left&lt;br&gt;3. &lt;b&gt;materialize&lt;/b&gt;: pick each recipient device and token (rules on the right)&lt;br&gt;4. send through the router, one push_deliveries row per token&lt;br&gt;5. settle: sent / partial_failed / failed; transient failure retried after 60s, 120s (3 attempts); APNs 410 / Unregistered or FCM unregistered → token invalidated" vertex="1">
          <mxGeometry height="260" width="290" x="400" y="520" as="geometry" />
        </mxCell>
        <mxCell id="overview-rules-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;" value="&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;b&gt;Who each channel reaches&lt;/b&gt; (token kind)&lt;br&gt;&lt;br&gt;&lt;b&gt;schedule start&lt;/b&gt; → that iPhone/iPad&#39;s &lt;i&gt;push_to_start&lt;/i&gt; token. Skipped if the activity is already registered; a class start on a school holiday is cancelled.&lt;br&gt;&lt;br&gt;&lt;b&gt;schedule end&lt;/b&gt; → the &lt;i&gt;live_activity_update&lt;/i&gt; token whose scope is that activity id.&lt;br&gt;&lt;br&gt;&lt;b&gt;system / sync_trigger&lt;/b&gt; → &lt;i&gt;standard&lt;/i&gt; token of every device with cloud sync on, except the device whose change caused it.&lt;br&gt;&lt;br&gt;&lt;b&gt;system / reauth_required&lt;/b&gt; → every device but macOS, copy in each device&#39;s language.&lt;br&gt;&lt;br&gt;&lt;b&gt;assignment&lt;/b&gt; → iPhone/iPad on app ≥ 2.1.0 with cloud sync and assignment reminders on.&lt;br&gt;&lt;br&gt;&lt;b&gt;course&lt;/b&gt; → iPhone/iPad only.&lt;br&gt;&lt;br&gt;&lt;b&gt;bulletin&lt;/b&gt; → devices with bulletin pushes on.&lt;br&gt;&lt;br&gt;&lt;b&gt;custom&lt;/b&gt; → the device the portal filed it for.&lt;br&gt;&lt;br&gt;&lt;b&gt;macOS&lt;/b&gt; → never." vertex="1">
          <mxGeometry height="520" width="320" x="740" y="360" as="geometry" />
        </mxCell>
        <mxCell id="overview-apns-16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" value="&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;b&gt;APNs&lt;/b&gt; (HTTP/2, JWT .p8)&lt;br&gt;one connection kept open 600s idle, TCP keepalive after 60s, 15s cap per send&lt;br&gt;&lt;br&gt;&lt;b&gt;alert&lt;/b&gt; · topic = bundle id · priority 10 · TTL 24h&lt;br&gt;&amp;nbsp;bulletin, reminders, reauth: title/body, badge, sound, thread-id&lt;br&gt;&amp;nbsp;custom popup: title/body at top level, sound only if force_ring&lt;br&gt;&amp;nbsp;custom bulletin: bulletin_id, sound only if force_ring&lt;br&gt;&lt;br&gt;&lt;b&gt;background&lt;/b&gt; · priority 5 · TTL 5 min&lt;br&gt;&amp;nbsp;sync_trigger: content-available&lt;br&gt;&lt;br&gt;&lt;b&gt;liveactivity&lt;/b&gt; · topic = bundle.push-type.liveactivity · priority 10&lt;br&gt;&amp;nbsp;start: event start, attributes-type + activityId, alert, stale-date, input-push-token&lt;br&gt;&amp;nbsp;end: event end, dismissal-date = now" vertex="1">
          <mxGeometry height="330" width="340" x="1150" y="200" as="geometry" />
        </mxCell>
        <mxCell id="overview-fcm-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;" value="&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;b&gt;FCM&lt;/b&gt; (firebase-admin, HTTP v1)&lt;br&gt;10s per request, 30s cap per send&lt;br&gt;&lt;br&gt;Data-only messages: the app builds every notification itself.&lt;br&gt;&lt;br&gt;&lt;b&gt;high priority&lt;/b&gt; · TTL 24h&lt;br&gt;&amp;nbsp;bulletin, reauth, custom: title, body, android_channel_id + payload keys&lt;br&gt;&amp;nbsp;channel ids: bulletin → bulletins_sound, reauth → system,&lt;br&gt;&amp;nbsp;custom → bulletins_silent, or bulletins_sound if force_ring&lt;br&gt;&lt;br&gt;&lt;b&gt;normal priority&lt;/b&gt; · TTL 12h · collapse key “sync”&lt;br&gt;&amp;nbsp;sync_trigger&lt;br&gt;&lt;br&gt;No Live Activities, no class or assignment reminders." vertex="1">
          <mxGeometry height="290" width="340" x="1150" y="600" as="geometry" />
        </mxCell>
        <mxCell id="overview-iphone-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" value="&lt;b&gt;iPhone / iPad&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;alert&lt;/b&gt; → shown by iOS; tap opens the bulletin / popup&lt;br&gt;&lt;b&gt;background&lt;/b&gt; → app wakes and syncs&lt;br&gt;&lt;b&gt;liveactivity start&lt;/b&gt; → ActivityKit shows the activity, then wakes the app with its update token → app calls /live-activities/register&lt;br&gt;&lt;b&gt;liveactivity end&lt;/b&gt; → activity dismissed" vertex="1">
          <mxGeometry height="200" width="330" x="1580" y="200" as="geometry" />
        </mxCell>
        <mxCell id="overview-android-19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;" value="&lt;b&gt;Android&lt;/b&gt; (FcmService, routes on &lt;i&gt;kind&lt;/i&gt;)&lt;br&gt;&lt;br&gt;&lt;b&gt;sync_trigger&lt;/b&gt; → one queued background sync (network required); one landing mid-sync queues a single follow-up&lt;br&gt;&lt;b&gt;custom_push_popup&lt;/b&gt; → popup notification (de-duplicated by notification_id)&lt;br&gt;&lt;b&gt;custom_push_bulletin&lt;/b&gt; → notification opening the stored bulletin&lt;br&gt;&lt;b&gt;reauth_required&lt;/b&gt; → sign-in notification&lt;br&gt;&lt;b&gt;anything else&lt;/b&gt; → bulletin notification if it has a bulletin_id, otherwise dropped" vertex="1">
          <mxGeometry height="220" width="330" x="1580" y="600" as="geometry" />
        </mxCell>
        <mxCell id="overview-e-20" edge="1" parent="1" source="overview-ios-4" style="edgeStyle=none;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="overview-jobs-13" value="">
