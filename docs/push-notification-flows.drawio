        <mxCell id="overview-e-34" edge="1" parent="1" source="overview-iphone-18" style="edgeStyle=none;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;dashed=1;dashPattern=6 3;strokeColor=#6c8ebf;fontColor=#6c8ebf;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.8387096774193549;entryY=0;entryDx=0;entryDy=0;" target="overview-ios-4" value="register update token">
