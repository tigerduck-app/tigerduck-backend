        </mxCell>
        <mxCell id="overview-n-35" parent="1" style="swimlane;startSize=26;fontStyle=1;fontSize=13;align=left;spacingLeft=10;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1a1a1a;" value="Signed-out (anonymous) devices: older path, bypasses push_jobs" vertex="1">
          <mxGeometry height="260" width="1890" x="20" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="overview-anon-36" parent="overview-n-35" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" value="&lt;b&gt;device_registrations&lt;/b&gt;&lt;br&gt;POST /v3/devices/anonymous&lt;br&gt;an app never signed in, with its push token and bulletin subscription rules" vertex="1">
          <mxGeometry height="100" width="300" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="overview-adisp-37" parent="overview-n-35" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" value="&lt;b&gt;Bulletin dispatcher&lt;/b&gt; (every 60s)&lt;br&gt;processed bulletin → devices whose subscription rules match → bulletin_dispatches rows → router directly (no push_jobs, no pipeline)" vertex="1">
          <mxGeometry height="100" width="330" x="400" y="40" as="geometry" />
        </mxCell>
        <mxCell id="overview-acust-38" parent="overview-n-35" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1a1a1a;dashed=1;dashPattern=6 3;" value="&lt;b&gt;Custom push dispatcher&lt;/b&gt; (every 60s)&lt;br&gt;drains custom_push_dispatches. Nothing writes that table any more: the portal files push_jobs for signed-in devices instead." vertex="1">
          <mxGeometry height="90" width="330" x="400" y="150" as="geometry" />
        </mxCell>
        <mxCell id="overview-aout-39" parent="overview-n-35" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;" value="→ &lt;b&gt;APNs alert&lt;/b&gt; (bulletin_id) / &lt;b&gt;FCM high-priority data&lt;/b&gt; (bulletin_id)&lt;br&gt;the same requests as signed-in bulletins" vertex="1">
          <mxGeometry height="60" width="380" x="820" y="60" as="geometry" />
        </mxCell>
        <mxCell id="overview-e-40" edge="1" parent="1" source="overview-anon-36" style="edgeStyle=none;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="overview-adisp-37" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="overview-e-41" edge="1" parent="1" source="overview-adisp-37" style="edgeStyle=none;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="overview-aout-39" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="overview-e-42" edge="1" parent="1" source="overview-acust-38" style="edgeStyle=none;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;dashed=1;dashPattern=6 3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" target="overview-aout-39" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="795" y="1395" />
              <mxPoint x="795" y="1305" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2. Live Activity lifecycle" id="la">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="la-n-1" value="Apple Live Activity: start to dismissal" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="la-n-2" value="One class (or urgent assignment) = one activity id “{scenario}::{sourceId}”. Start and end are separate push_jobs; the end only exists once the phone registers the activity." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="42" width="1500" height="20" as="geometry" />
        </mxCell>
        <mxCell id="la-n-3" value="iPhone app" style="swimlane;startSize=26;fontStyle=1;fontSize=13;align=left;spacingLeft=10;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="430" height="750" as="geometry" />
        </mxCell>
        <mxCell id="la-n-4" value="Server (API + pipeline)" style="swimlane;startSize=26;fontStyle=1;fontSize=13;align=left;spacingLeft=10;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="470" y="80" width="430" height="750" as="geometry" />
        </mxCell>
        <mxCell id="la-n-5" value="APNs" style="swimlane;startSize=26;fontStyle=1;fontSize=13;align=left;spacingLeft=10;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="920" y="80" width="430" height="750" as="geometry" />
        </mxCell>
        <mxCell id="la-n-6" value="iPhone (ActivityKit / iOS)" style="swimlane;startSize=26;fontStyle=1;fontSize=13;align=left;spacingLeft=10;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="1370" y="80" width="430" height="750" as="geometry" />
        </mxCell>
        <mxCell id="la-s-7" value="&lt;b&gt;1. Register for push-to-start&lt;/b&gt;&lt;br&gt;on launch: push-to-start token for TigerDuckActivityAttributes → /v3/devices (token_kind push_to_start)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;" vertex="1" parent="la-n-3">
          <mxGeometry x="15" y="40" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="la-s-8" value="&lt;b&gt;2. Upload the schedule&lt;/b&gt;&lt;br&gt;POST /v3/schedule/sync: each upcoming class / assignment event with its snapshot and fire time" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;" vertex="1" parent="la-n-3">
          <mxGeometry x="15" y="150" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="la-s-9" value="&lt;b&gt;3. File start jobs&lt;/b&gt;&lt;br&gt;one schedule job per event at fire_at, priority 10, dedupe schedule:{device}:…; jobs no longer in the upload are cancelled" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;" vertex="1" parent="la-n-4">
          <mxGeometry x="15" y="150" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="la-s-10" value="&lt;b&gt;4. At fire_at the tick sends the start&lt;/b&gt; (≤ 5s late)&lt;br&gt;• class start on a school holiday → cancelled&lt;br&gt;• activity already registered by the phone → skipped&lt;br&gt;• else APNs liveactivity &lt;b&gt;event: start&lt;/b&gt; to the push_to_start token: attributes-type, activityId, content-state.snapshot, alert, stale-date = countdown, input-push-token: 1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;" vertex="1" parent="la-n-4">
          <mxGeometry x="15" y="290" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="la-s-11" value="&lt;b&gt;5. Deliver the start&lt;/b&gt;&lt;br&gt;collapse id per activity, priority 10" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;" vertex="1" parent="la-n-5">
          <mxGeometry x="15" y="290" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="la-s-12" value="&lt;b&gt;6. Activity appears&lt;/b&gt;&lt;br&gt;lock screen + Dynamic Island, alert shown. iOS issues the activity&#39;s update token and wakes TigerDuck in the background, even when it isn&#39;t running or the phone is locked" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;" vertex="1" parent="la-n-6">
          <mxGeometry x="15" y="290" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="la-s-13" value="&lt;b&gt;7. Register the activity&lt;/b&gt;&lt;br&gt;observer sees the activity and its update token → POST /v3/live-activities/register (activity id, token, snapshot, countdown_target). Works behind a locked screen: the session, device id and endpoint are readable after first unlock" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;" vertex="1" parent="la-n-3">
          <mxGeometry x="15" y="460" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="la-s-14" value="&lt;b&gt;8. File the end job&lt;/b&gt;&lt;br&gt;live_activity_update token stored (scope = activity id); end job at countdown_target, priority 10 (an earlier sent end on the same id is moved aside)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;" vertex="1" parent="la-n-4">
          <mxGeometry x="15" y="460" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="la-s-15" value="&lt;b&gt;9. At countdown_target the tick sends the end&lt;/b&gt; (≤ 5s late, ahead of other due jobs)&lt;br&gt;APNs liveactivity &lt;b&gt;event: end&lt;/b&gt;, dismissal-date = now, to the update token" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;" vertex="1" parent="la-n-4">
          <mxGeometry x="15" y="610" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="la-s-16" value="&lt;b&gt;10. Deliver the end&lt;/b&gt;&lt;br&gt;same collapse id: an end replaces an undelivered start" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;" vertex="1" parent="la-n-5">
          <mxGeometry x="15" y="610" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="la-s-17" value="&lt;b&gt;11. Activity dismissed&lt;/b&gt;&lt;br&gt;about 1–3s after the class ends" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;" vertex="1" parent="la-n-6">
          <mxGeometry x="15" y="610" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="la-e-18" value="" style="edgeStyle=none;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;dashed=1;dashPattern=6 3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.18181818181818182;entryDx=0;entryDy=0;" edge="1" parent="1" source="la-s-7" target="la-s-9">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="460" y="165" />
              <mxPoint x="460" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="la-e-19" value="" style="edgeStyle=none;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4090909090909091;entryDx=0;entryDy=0;" edge="1" parent="1" source="la-s-8" target="la-s-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="la-e-20" value="" style="edgeStyle=none;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="la-s-9" target="la-s-10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="la-e-21" value="" style="edgeStyle=none;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.23333333333333334;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="la-s-10" target="la-s-11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="la-e-22" value="" style="edgeStyle=none;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3181818181818182;entryDx=0;entryDy=0;" edge="1" parent="1" source="la-s-11" target="la-s-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="la-e-23" value="wakes app" style="edgeStyle=none;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;dashed=1;dashPattern=6 3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="la-s-12" target="la-s-13">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1585" y="530" />
              <mxPoint x="235" y="530" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="la-e-24" value="" style="edgeStyle=none;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.4230769230769231;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="la-s-13" target="la-s-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="la-e-25" value="" style="edgeStyle=none;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="la-s-14" target="la-s-15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="la-e-26" value="" style="edgeStyle=none;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.3181818181818182;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="la-s-15" target="la-s-16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="la-e-27" value="" style="edgeStyle=none;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4375;entryDx=0;entryDy=0;" edge="1" parent="1" source="la-s-16" target="la-s-17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="la-other-28" value="&lt;b&gt;Other ways an activity ends early or is cleaned up&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Assignment submitted&lt;/b&gt;: the end job of its assignmentUrgent activity is moved to now (server).&lt;br&gt;• &lt;b&gt;Portal “end now”&lt;/b&gt;: moves a pending end job to now and runs the pipeline.&lt;br&gt;• &lt;b&gt;App running at the countdown&lt;/b&gt;: the app ends the activity itself 1s after it.&lt;br&gt;• &lt;b&gt;App opened later&lt;/b&gt;: on foreground the app ends any activity past its countdown.&lt;br&gt;• &lt;b&gt;No end ever arrives&lt;/b&gt; (phone offline past the TTL, push dropped, never registered): the activity greys out at stale-date and stays until the app is opened or iOS ends it (8 hours); the widget reads “class over” instead of a countdown." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="20" y="850" width="860" height="200" as="geometry" />
        </mxCell>
        <mxCell id="la-timing-29" value="&lt;b&gt;Timing that decides how fast it clears&lt;/b&gt;&lt;br&gt;&lt;br&gt;pipeline tick every 5s · Live Activity jobs claimed first (priority 10) · one tick drains every due job · APNs connection reused (no handshake per send) · end sent within 5s of the countdown (measured 1–3s), dismissed about 2s later; a locked phone registered about 10s after the start." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="920" y="850" width="860" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3. Every scenario" id="table">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="table-n-1" value="Every scenario that reaches APNs or FCM" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="table-n-2" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top;color:#1a1a1a;background:#dae8fc;text-align:left;&quot;&gt;Scenario&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top;color:#1a1a1a;background:#dae8fc;text-align:left;&quot;&gt;Trigger&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top;color:#1a1a1a;background:#dae8fc;text-align:left;&quot;&gt;push_jobs channel / kind&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top;color:#1a1a1a;background:#dae8fc;text-align:left;&quot;&gt;Who receives it&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top;color:#1a1a1a;background:#dae8fc;text-align:left;&quot;&gt;APNs request&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top;color:#1a1a1a;background:#dae8fc;text-align:left;&quot;&gt;FCM message&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top;color:#1a1a1a;background:#dae8fc;text-align:left;&quot;&gt;On the device&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top;color:#1a1a1a;background:#ffffff;&quot;&gt;&lt;b&gt;Live Activity start&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top;color:#1a1a1a;background:#ffffff;&quot;&gt;iOS /schedule/sync event reaches its fire time&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top;color:#1a1a1a;background:#ffffff;&quot;&gt;schedule / schedule&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top;color:#1a1a1a;background:#ffffff;&quot;&gt;that iPhone/iPad (push_to_start token)&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top;color:#1a1a1a;background:#ffffff;&quot;&gt;liveactivity event start&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top;color:#1a1a1a;background:#ffffff;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top;color:#1a1a1a;background:#ffffff;&quot;&gt;activity appears; app woken to register it&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top;color:#1a1a1a;background:#f5f5f5;&quot;&gt;&lt;b&gt;Live Activity end&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top;color:#1a1a1a;background:#f5f5f5;&quot;&gt;/live-activities/register; countdown_target reached (or submitted / portal end-now)&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top;color:#1a1a1a;background:#f5f5f5;&quot;&gt;schedule / live_activity_end&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top;color:#1a1a1a;background:#f5f5f5;&quot;&gt;that iPhone/iPad (update token for the activity)&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top;color:#1a1a1a;background:#f5f5f5;&quot;&gt;liveactivity event end, dismissal-date now&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top;color:#1a1a1a;background:#f5f5f5;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top;color:#1a1a1a;background:#f5f5f5;&quot;&gt;activity dismissed&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top;color:#1a1a1a;background:#ffffff;&quot;&gt;&lt;b&gt;Sync trigger&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6px;vertical-align:top;color:#1a1a1a;background:#ffffff;&quot;&gt;another device uploaded changes, or the server sync found changes&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px 6