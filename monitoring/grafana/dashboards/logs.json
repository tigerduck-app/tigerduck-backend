    {
      "type": "bargauge",
      "title": "Errors by service in range",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service) (count_over_time({service=~\"$service\"} | detected_level=~\"error|critical\" [$__range]))",
          "legendFormat": "{{service}}",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
