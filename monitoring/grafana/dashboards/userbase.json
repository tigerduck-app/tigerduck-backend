    {
      "type": "timeseries",
      "title": "Users",
      "description": "Registered: distinct student IDs. Active (dashed): students with a device active in the trailing 14 days. A device is active for 14 days after any login, token refresh or request. Apps in use refresh their token every 15 minutes, and every refresh is kept, so the history reaches back to launch.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tigerduck-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tigerduck-db"
          },
          "rawSql": "WITH points AS (\n    -- Sample times across the range, plus now() so the last point is the\n    -- current number.\n    SELECT generate_series(\n               date_trunc('hour', $__timeFrom()::timestamptz),\n               now(),\n               GREATEST(make_interval(secs => $__interval_ms / 1000.0), interval '1 hour')\n           ) AS t\n    UNION\n    SELECT now()\n),\nseen AS (\n    SELECT device_id, created_at AS at\n    FROM auth_sessions\n    WHERE device_id IS NOT NULL\n      AND created_at > $__timeFrom()::timestamptz - interval '14 days'\n    UNION ALL\n    SELECT id, last_seen_at\n    FROM user_devices\n    WHERE last_seen_at > $__timeFrom()::timestamptz - interval '14 days'\n),\ndaily AS (\n    -- Cuts millions of session rows down to one per key per day, keeping\n    -- the exact first and last moment so stretch edges stay exact.\n    SELECT u.student_id AS key, date_trunc('day', s.at) AS day, min(s.at) AS first_at, max(s.at) AS last_at\n    FROM seen s\n    JOIN user_devices d ON d.id = s.device_id JOIN users u ON u.id = d.user_id AND u.student_id IS NOT NULL\n    GROUP BY 1, 2\n),\nmarked AS (\n    SELECT key, first_at, last_at,\n           CASE WHEN lag(last_at) OVER w + interval '14 days' >= first_at THEN 0 ELSE 1 END AS starts_new\n    FROM daily\n    WINDOW w AS (PARTITION BY key ORDER BY day)\n),\nnumbered AS (\n    SELECT key, first_at, last_at, sum(starts_new) OVER (PARTITION BY key ORDER BY first_at) AS stretch\n    FROM marked\n),\nspans AS (\n    SELECT key, min(first_at) AS active_from, max(last_at) + interval '14 days' AS active_until\n    FROM numbered\n    GROUP BY key, stretch\n)\nSELECT p.t AS \"time\",\n       (SELECT count(DISTINCT u.student_id)\n        FROM users u\n        WHERE u.student_id IS NOT NULL\n          AND u.created_at <= p.t\n          AND (u.deleted_at IS NULL OR u.deleted_at > p.t)) AS \"Registered users\",\n       (SELECT count(*)\n        FROM spans\n        WHERE active_from <= p.t AND active_until > p.t) AS \"Active users, 14 days\"\nFROM points p\nORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": [
