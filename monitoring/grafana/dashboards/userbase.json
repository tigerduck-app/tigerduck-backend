      "type": "timeseries",
      "title": "Devices",
      "description": "Solid: registered devices. Dashed: devices active in the trailing 14 days. Same colour, same platform. Hover for the totals. A device is active for 14 days after any login, token refresh or request. Apps in use refresh their token every 15 minutes, and every refresh is kept, so the history reaches back to launch.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tigerduck-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tigerduck-db"
          },
          "rawSql": "WITH points AS (\n    -- Sample times across the range, plus now() so the last point is the\n    -- current number.\n    SELECT generate_series(\n               date_trunc('hour', $__timeFrom()::timestamptz),\n               now(),\n               GREATEST(make_interval(secs => $__interval_ms / 1000.0), interval '1 hour')\n           ) AS t\n    UNION\n    SELECT now()\n),\nseen AS (\n    SELECT device_id, created_at AS at\n    FROM auth_sessions\n    WHERE device_id IS NOT NULL\n      AND created_at > $__timeFrom()::timestamptz - interval '14 days'\n    UNION ALL\n    SELECT id, last_seen_at\n    FROM user_devices\n    WHERE last_seen_at > $__timeFrom()::timestamptz - interval '14 days'\n),\ndaily AS (\n    -- Cuts millions of session rows down to one per key per day, keeping\n    -- the exact first and last moment so stretch edges stay exact.\n    SELECT s.device_id AS key, date_trunc('day', s.at) AS day, min(s.at) AS first_at, max(s.at) AS last_at\n    FROM seen s\n    \n    GROUP BY 1, 2\n),\nmarked AS (\n    SELECT key, first_at, last_at,\n           CASE WHEN lag(last_at) OVER w + interval '14 days' >= first_at THEN 0 ELSE 1 END AS starts_new\n    FROM daily\n    WINDOW w AS (PARTITION BY key ORDER BY day)\n),\nnumbered AS (\n    SELECT key, first_at, last_at, sum(starts_new) OVER (PARTITION BY key ORDER BY first_at) AS stretch\n    FROM marked\n),\nspans AS (\n    SELECT key, min(first_at) AS active_from, max(last_at) + interval '14 days' AS active_until\n    FROM numbered\n    GROUP BY key, stretch\n),\ndev AS (\n    SELECT id, created_at, deleted_at,\n           CASE WHEN platform IN ('ios', 'ipados') THEN 'iphone_ipad'\n                WHEN platform = 'macos' THEN 'macos'\n                WHEN platform = 'android' THEN 'android'\n                ELSE 'other' END AS grp\n    FROM user_devices\n),\nactive_spans AS (\n    SELECT d.grp, s.active_from, s.active_until\n    FROM spans s\n    JOIN dev d ON d.id = s.key\n)\nSELECT p.t AS \"time\", reg.*, act.*\nFROM points p\nCROSS JOIN LATERAL (\n    SELECT count(*) FILTER (WHERE grp = 'iphone_ipad') AS \"Registered: iPhone + iPad\",\n           count(*) FILTER (WHERE grp = 'macos') AS \"Registered: macOS\",\n           count(*) FILTER (WHERE grp = 'android') AS \"Registered: Android\",\n           count(*) AS \"Registered: all\"\n    FROM dev\n    WHERE created_at <= p.t AND (deleted_at IS NULL OR deleted_at > p.t)\n) AS reg\nCROSS JOIN LATERAL (\n    SELECT count(*) FILTER (WHERE grp = 'iphone_ipad') AS \"Active 14d: iPhone + iPad\",\n           count(*) FILTER (WHERE grp = 'macos') AS \"Active 14d: macOS\",\n           count(*) FILTER (WHERE grp = 'android') AS \"Active 14d: Android\",\n           count(*) AS \"Active 14d: all\"\n    FROM active_spans\n    WHERE active_from <= p.t AND active_until > p.t\n) AS act\nORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*iPhone \\+ iPad$"
            },
            "properties": [
              {
                "id": "color",
