    {
      "type": "timeseries",
      "title": "New devices per day",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tigerduck-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tigerduck-db"
          },
          "rawSql": "WITH days AS (\n    SELECT generate_series(date_trunc('day', $__timeFrom()::timestamptz, 'Asia/Taipei'), $__timeTo()::timestamptz, interval '1 day') AS day\n),\ncounts AS (\nSELECT date_trunc('day', created_at, 'Asia/Taipei') AS day,\n       CASE WHEN platform IN ('ios', 'ipados') THEN 'iPhone + iPad'\n                WHEN platform = 'macos' THEN 'macOS'\n                WHEN platform = 'android' THEN 'Android'\n                ELSE 'other' END AS metric,\n       count(*) AS value\nFROM user_devices\nWHERE $__timeFilter(created_at)\nGROUP BY 1, 2\n),\nmetrics AS (SELECT DISTINCT metric FROM counts)\nSELECT d.day AS \"time\", m.metric, COALESCE(c.value, 0) AS value\nFROM days d\nCROSS JOIN metrics m\nLEFT JOIN counts c ON c.day = d.day AND c.metric = m.metric\nORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
