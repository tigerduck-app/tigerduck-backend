    {
      "type": "timeseries",
      "title": "New users per day",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tigerduck-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tigerduck-db"
          },
          "rawSql": "WITH days AS (\n    SELECT generate_series(date_trunc('day', $__timeFrom()::timestamptz, 'Asia/Taipei'), $__timeTo()::timestamptz, interval '1 day') AS day\n),\ncounts AS (\nSELECT date_trunc('day', created_at, 'Asia/Taipei') AS day, count(DISTINCT student_id) AS value\nFROM users\nWHERE student_id IS NOT NULL AND $__timeFilter(created_at)\nGROUP BY 1\n)\nSELECT d.day AS \"time\", COALESCE(c.value, 0) AS value\nFROM days d\nLEFT JOIN counts c ON c.day = d.day\nORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
