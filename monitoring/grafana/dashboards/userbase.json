    {
      "type": "timeseries",
      "title": "Users",
      "description": "Registered: distinct student IDs. Active (dashed): students with a device active in the trailing 14 days. A device is active for 14 days after any login, token refresh or request. Apps in use refresh their token every 15 minutes, and every refresh is kept, so the history reaches back to launch.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tigerduck-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tigerduck-db"
          },
          "rawSql": "WITH points AS (\n    -- Sample times across the range, plus now() so the last point is the\n    -- current number.\n    SELECT generate_series(\n               date_trunc('hour', $__timeFrom()::timestamptz),\n               now(),\n               GREATEST(make_interval(secs => $__interval_ms / 1000.0), interval '1 hour')\n           ) AS t\n    UNION\n    SELECT now()\n),\nseen AS (\n    -- Activity: logins and access-token refreshes (auth_sessions keeps every\n    -- one, and an app in use refreshes every 15 minutes), plus each\n    -- device's latest request.\n    SELECT device_id, created_at AS at\n    FROM auth_sessions\n    WHERE device_id IS NOT NULL\n      AND created_at > $__timeFrom()::timestamptz - interval '14 days'\n    UNION ALL\n    SELECT id, last_seen_at\n    FROM user_devices\n    WHERE last_seen_at > $__timeFrom()::timestamptz - interval '14 days'\n),\ndev AS (\n    SELECT d.id, d.created_at, d.deleted_at, u.student_id,\n           CASE WHEN d.platform IN ('ios', 'ipados') THEN 'iphone_ipad'\n                WHEN d.platform = 'macos' THEN 'macos'\n                WHEN d.platform = 'android' THEN 'android'\n                ELSE 'other' END AS grp\n    FROM user_devices d\n    JOIN users u ON u.id = d.user_id\n),\ndevice_daily AS (\n    SELECT device_id AS key, date_trunc('day', at) AS day, min(at) AS first_at, max(at) AS last_at\n    FROM seen\n    GROUP BY 1, 2\n),\nstudent_daily AS (\n    SELECT dv.student_id AS key, dd.day, min(dd.first_at) AS first_at, max(dd.last_at) AS last_at\n    FROM device_daily dd\n    JOIN dev dv ON dv.id = dd.key\n    WHERE dv.student_id IS NOT NULL\n    GROUP BY 1, 2\n),\ndevice_marked AS (\n    SELECT key, day, first_at, last_at,\n           CASE WHEN lag(last_at) OVER w + interval '14 days' >= first_at THEN 0 ELSE 1 END AS starts_new\n    FROM device_daily\n    WINDOW w AS (PARTITION BY key ORDER BY day)\n),\ndevice_numbered AS (\n    SELECT key, first_at, last_at, sum(starts_new) OVER (PARTITION BY key ORDER BY day) AS stretch\n    FROM device_marked\n),\ndevice_spans AS (\n    SELECT key, min(first_at) AS active_from, max(last_at) + interval '14 days' AS active_until\n    FROM device_numbered\n    GROUP BY key, stretch\n),\nstudent_marked AS (\n    SELECT key, day, first_at, last_at,\n           CASE WHEN lag(last_at) OVER w + interval '14 days' >= first_at THEN 0 ELSE 1 END AS starts_new\n    FROM student_daily\n    WINDOW w AS (PARTITION BY key ORDER BY day)\n),\nstudent_numbered AS (\n    SELECT key, first_at, last_at, sum(starts_new) OVER (PARTITION BY key ORDER BY day) AS stretch\n    FROM student_marked\n),\nstudent_spans AS (\n    SELECT key, min(first_at) AS active_from, max(last_at) + interval '14 days' AS active_until\n    FROM student_numbered\n    GROUP BY key, stretch\n)\nSELECT p.t AS \"time\", usr.*, reg.*, act.*,\n       usr.\"Active users, 14 days\"::float / NULLIF(usr.\"Registered users\", 0) AS \"Active share\"\nFROM points p\nCROSS JOIN LATERAL (\n    SELECT (SELECT count(DISTINCT u.student_id)\n            FROM users u\n            WHERE u.student_id IS NOT NULL\n              AND u.created_at <= p.t\n              AND (u.deleted_at IS NULL OR u.deleted_at > p.t)) AS \"Registered users\",\n           (SELECT count(*)\n            FROM student_spans s\n            WHERE s.active_from <= p.t AND s.active_until > p.t\n              -- Counted like \"Registered users\": not before the account\n              -- existed, nor after it was deleted.\n              AND EXISTS (SELECT 1\n                          FROM users u\n                          WHERE u.student_id = s.key\n                            AND u.created_at <= p.t\n                            AND (u.deleted_at IS NULL OR u.deleted_at > p.t))) AS \"Active users, 14 days\"\n) AS usr\nCROSS JOIN LATERAL (\n    SELECT count(*) FILTER (WHERE grp = 'iphone_ipad') AS \"Registered: iPhone + iPad\",\n           count(*) FILTER (WHERE grp = 'macos') AS \"Registered: macOS\",\n           count(*) FILTER (WHERE grp = 'android') AS \"Registered: Android\",\n           count(*) AS \"Registered: all\"\n    FROM dev\n    WHERE created_at <= p.t AND (deleted_at IS NULL OR deleted_at > p.t)\n) AS reg\nCROSS JOIN LATERAL (\n    SELECT count(*) FILTER (WHERE dv.grp = 'iphone_ipad') AS \"Active 14d: iPhone + iPad\",\n           count(*) FILTER (WHERE dv.grp = 'macos') AS \"Active 14d: macOS\",\n           count(*) FILTER (WHERE dv.grp = 'android') AS \"Active 14d: Android\",\n           count(*) AS \"Active 14d: all\"\n    FROM device_spans s\n    JOIN dev dv ON dv.id = s.key\n    WHERE s.active_from <= p.t AND s.active_until > p.t\n      -- A deleted device stops counting as active, as it stops counting\n      -- as registered.\n      AND (dv.deleted_at IS NULL OR dv.deleted_at > p.t)\n) AS act\nORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Registered users"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Active users, 14 days"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "maxDataPoints": 200,
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "exclude": {
              "pattern": "^((Registered|Active 14d): .*|Active share)$"
            }
          }
        }
