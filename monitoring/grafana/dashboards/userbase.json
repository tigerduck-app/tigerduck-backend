    {
      "type": "stat",
      "title": "New users in range",
      "description": "Students whose first sign-in falls in the selected time range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tigerduck-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tigerduck-db"
          },
          "rawSql": "SELECT count(DISTINCT student_id) AS \"new\"\nFROM users\nWHERE student_id IS NOT NULL AND deleted_at IS NULL AND $__timeFilter(created_at)",
          "format": "table",
