    {
      "type": "stat",
      "title": "Active share",
      "description": "Share of registered students active in the last 14 days, by their devices' latest request.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tigerduck-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tigerduck-db"
          },
          "rawSql": "SELECT count(DISTINCT u.student_id) FILTER (WHERE d.last_seen_at > now() - interval '14 days')::float\n       / NULLIF(count(DISTINCT u.student_id), 0) AS \"active share\"\nFROM users u\nLEFT JOIN user_devices d ON d.user_id = u.id AND d.deleted_at IS NULL\nWHERE u.student_id IS NOT NULL AND u.deleted_at IS NULL",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 6,
