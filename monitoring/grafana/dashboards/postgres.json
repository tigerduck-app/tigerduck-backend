    {
      "type": "table",
      "title": "Sessions by client",
      "description": "Who holds connections right now. The backend and portal both log in as tigerduck; tell them apart by client address. tigerduck_monitor is Grafana and the exporters.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tigerduck-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tigerduck-db"
          },
          "rawSql": "SELECT usename AS \"role\",\n       COALESCE(NULLIF(application_name, ''), '-') AS \"application\",\n       COALESCE(client_addr::text, 'local') AS \"client\",\n       count(*) AS \"total\",\n       count(*) FILTER (WHERE state = 'active') AS \"active\",\n       count(*) FILTER (WHERE state = 'idle') AS \"idle\",\n       count(*) FILTER (WHERE state LIKE 'idle in transaction%') AS \"idle in tx\"\nFROM pg_stat_activity\nWHERE datname = 'tigerduck'\nGROUP BY 1, 2, 3\nORDER BY \"total\" DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 6
      }
    },
    {
      "type": "table",
      "title": "Live sessions",
      "description": "Every session on the tigerduck database, oldest transaction first. Snapshot at refresh time.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tigerduck-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tigerduck-db"
          },
          "rawSql": "SELECT pid,\n       usename AS \"role\",\n       COALESCE(client_addr::text, 'local') AS \"client\",\n       state,\n       wait_event_type || ': ' || wait_event AS \"waiting on\",\n       round(extract(epoch FROM now() - xact_start))::int AS \"in transaction\",\n       round(extract(epoch FROM now() - query_start))::int AS \"since last query\",\n       left(query, 300) AS \"last query\"\nFROM pg_stat_activity\nWHERE datname = 'tigerduck' AND pid <> pg_backend_pid()\nORDER BY xact_start NULLS LAST, query_start",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "in transaction"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "since last query"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 7
