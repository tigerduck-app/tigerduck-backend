    {
      "type": "timeseries",
      "title": "Cache hit ratio",
      "description": "Share of block reads served from shared buffers. Gaps mean nothing was read.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pg_stat_database_blks_hit{datname=\"tigerduck\"}[$__rate_interval])) / (sum(rate(pg_stat_database_blks_hit{datname=\"tigerduck\"}[$__rate_interval])) + sum(rate(pg_stat_database_blks_read{datname=\"tigerduck\"}[$__rate_interval])))",
          "legendFormat": "hit ratio",
          "range": true
        }
      ],
      "fieldConfig": {
